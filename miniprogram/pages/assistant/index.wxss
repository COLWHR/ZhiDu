.container {
  min-height: 100vh;
  background: #f4f7f5;
  padding: 30rpx 20rpx 48rpx;
  box-sizing: border-box;
}

.header-banner {
  background: #1e2124;
  border-radius: 48rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
}

.tag-badge {
  display: inline-block;
  background: rgba(59, 179, 107, 0.18);
  color: #8de2ad;
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  margin-bottom: 18rpx;
}

.main-title {
  color: #fff;
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.sub-title {
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  line-height: 1.55;
  margin-bottom: 30rpx;
}

.stats-row {
  display: flex;
  gap: 20rpx;
}

.stat-box {
  flex: 1;
  background: rgba(235, 247, 238, 0.1);
  border-radius: 28rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.stat-num {
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.stat-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  margin-top: 8rpx;
}

.search-filter-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.icon-search {
  width: 34rpx;
  color: #787f84;
  font-size: 32rpx;
  line-height: 1;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #333;
}

.ph-style {
  color: #a8b1c1;
}

.filter-btn {
  margin: 0;
  background: #ebf7ee;
  color: #2fa15c;
  border-radius: 999rpx;
  height: 72rpx;
  min-width: 128rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  gap: 8rpx;
  line-height: 72rpx;
}

.filter-btn::after,
.btn-action::after,
.chat-import-btn::after,
.send-btn::after {
  border: none;
}

.icon-filter {
  font-size: 30rpx;
  line-height: 1;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 30rpx;
}

.category-list {
  display: flex;
  padding-bottom: 10rpx;
}

.category-item {
  display: inline-block;
  background: #fff;
  color: #787f84;
  font-size: 26rpx;
  line-height: 1;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
}

.category-item.active {
  background: #3bb36b;
  color: #fff;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(59, 179, 107, 0.22);
}

.agent-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.agent-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #bdf238 0%, #9fe42e 100%);
  border-radius: 30rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 34rpx rgba(91, 139, 28, 0.2);
}

.agent-card::before {
  content: '';
  position: absolute;
  top: 108rpx;
  right: 30rpx;
  width: 72rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.62);
  transform: rotate(-18deg);
  z-index: 2;
}

.agent-card::after {
  content: '';
  position: absolute;
  left: 30rpx;
  top: 198rpx;
  width: 76rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.58);
  transform: rotate(-18deg);
  z-index: 2;
}

.card-header {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.avatar-box {
  width: 0;
  height: 0;
  margin: 0;
  overflow: hidden;
}

.agent-card:nth-child(2n) .avatar-box {
  background: transparent;
}

.agent-card:nth-child(3n) .avatar-box {
  background: transparent;
}

.agent-card:nth-child(4n) .avatar-box {
  background: transparent;
}

.avatar-icon {
  font-size: 0;
}

.header-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.agent-name {
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 800;
  color: #141914;
  line-height: 1.2;
}

.agent-title {
  flex-shrink: 0;
  max-width: 156rpx;
  padding-top: 4rpx;
  font-size: 18rpx;
  color: rgba(20, 25, 20, 0.62);
  line-height: 1.2;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  position: relative;
  z-index: 1;
  min-height: 150rpx;
  margin-bottom: 18rpx;
  padding: 34rpx 28rpx;
  border-radius: 18rpx;
  background: #1e2124;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  line-height: 1.55;
  box-sizing: border-box;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.tag {
  background: #ebf7ee;
  color: #2fa15c;
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.agent-card .card-tags {
  position: relative;
  z-index: 3;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.agent-card .tag {
  background: rgba(255, 255, 255, 0.82);
  color: #263126;
  font-size: 20rpx;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 800;
}

.card-actions,
.panel-actions,
.chat-head,
.composer {
  display: flex;
  gap: 16rpx;
}

.agent-card .card-actions {
  position: relative;
  z-index: 3;
  gap: 12rpx;
}

.btn-action {
  margin: 0;
  flex: 1;
  min-width: 0;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  font-size: 26rpx;
  padding: 0;
  border-radius: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-icon {
  font-size: 24rpx;
  line-height: 1;
}

.btn-outline-purple {
  background: #fff;
  color: #3bb36b;
  border: 2rpx solid #d8efdf;
}

.btn-outline-grey {
  background: #fff;
  color: #596273;
  border: 2rpx solid #e5e7eb;
}

.btn-solid-green {
  background: #3bb36b;
  color: #fff;
  border: 2rpx solid transparent;
  box-shadow: 0 12rpx 24rpx rgba(59, 179, 107, 0.22);
}

.agent-card .btn-action {
  height: 58rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: normal;
  gap: 6rpx;
}

.agent-card .btn-outline-purple,
.agent-card .btn-outline-grey,
.agent-card .btn-solid-green {
  background: rgba(255, 255, 255, 0.84);
  color: #263126;
  border: 0;
  box-shadow: none;
}

.empty {
  padding: 56rpx 20rpx;
  border-radius: 24rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  background: #fff;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.52);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  box-sizing: border-box;
  z-index: 20;
}

.panel {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 24rpx 64rpx rgba(15, 23, 42, 0.28);
  box-sizing: border-box;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2f3440;
  line-height: 1.35;
}

.panel-subtitle {
  margin-top: 8rpx;
  color: #99a1ad;
  font-size: 24rpx;
}

.detail {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #4f5a68;
  line-height: 1.75;
}

.panel-tags {
  margin-top: 18rpx;
}

.panel-section-title {
  margin: 22rpx 0 12rpx;
  font-size: 24rpx;
  color: #8f9aad;
  font-weight: 700;
}

.mono {
  white-space: pre-wrap;
  font-family: monospace;
  line-height: 1.7;
  color: #374151;
  background: #f4f7f5;
  padding: 18rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.panel-actions {
  margin-top: 24rpx;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chat-head {
  justify-content: space-between;
  align-items: flex-start;
}

.chat-import-btn {
  margin: 0;
  min-width: 112rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background: #ebf7ee;
  color: #2fa15c;
  font-size: 24rpx;
  font-weight: 700;
}

.chat-list {
  height: 58vh;
  border-radius: 22rpx;
  background: #f4f7f5;
  padding: 18rpx;
  box-sizing: border-box;
}

.chat-empty {
  padding: 32rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}

.message {
  display: flex;
  margin-bottom: 16rpx;
}

.message.user {
  justify-content: flex-end;
}

.message.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 82%;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.06);
}

.message.user .bubble {
  background: #3bb36b;
}

.speaker {
  font-size: 22rpx;
  color: #8f9aad;
  margin-bottom: 8rpx;
}

.message.user .speaker {
  color: rgba(255, 255, 255, 0.82);
}

.content {
  font-size: 26rpx;
  color: #2f3440;
  line-height: 1.7;
  white-space: pre-wrap;
}

.message.user .content {
  color: #fff;
}

.composer {
  align-items: flex-end;
}

.chat-input {
  flex: 1;
  min-height: 88rpx;
  max-height: 220rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f8faf8;
  border: 1rpx solid rgba(148, 163, 184, 0.2);
  font-size: 26rpx;
}

.send-btn {
  margin: 0;
  min-width: 132rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #3bb36b;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}
