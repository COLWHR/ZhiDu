.login-container {
  min-height: 100vh;
  background-color: #f4f7f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx 60rpx;
  box-sizing: border-box;
}

.hero-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 72rpx;
  margin-bottom: 44rpx;
}

.hero-image {
  width: 240rpx;
  height: 240rpx;
}

.brand-name {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1d1e;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.text-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.main-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1d1e;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
  line-height: 1.35;
}

.sub-title {
  font-size: 28rpx;
  color: #787f84;
  line-height: 1.45;
}

.form-section {
  width: 100%;
  margin-bottom: 36rpx;
}

.field {
  width: 100%;
  margin-bottom: 24rpx;
}

.login-input {
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  border-radius: 48rpx;
  padding: 0 34rpx;
  box-sizing: border-box;
  color: #1a1d1e;
  font-size: 30rpx;
}

.placeholder-style {
  color: #a6a6a6;
}

.error {
  color: #dc2626;
  background: #fef2f2;
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.action-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 80rpx;
}

.btn-wechat {
  width: 100% !important;
  background: #3bb36b;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 179, 107, 0.26);
  line-height: 1.35;
}

.btn-wechat::after {
  border: none;
}

.secondary-links {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2fa15c;
  font-size: 26rpx;
  margin-top: -4rpx;
}

.agreement-section {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.checkbox {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #cccccc;
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox.checked {
  background-color: #3bb36b;
  border-color: #3bb36b;
}

.check-mark {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.agreement-text {
  flex: 0 1 auto;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.link-text {
  color: #2fa15c;
}
