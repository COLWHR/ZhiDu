.debug-page {
  gap: 24rpx;
}

.hero-card,
.info-card,
.result-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.brand-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 4rpx;
  background: #1e2124;
  margin-bottom: 20rpx;
}

.kv-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kv-item {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f8faf8;
}

.kv-label {
  display: block;
  font-size: 24rpx;
  color: #787f84;
  margin-bottom: 8rpx;
}

.kv-value {
  display: block;
  font-size: 26rpx;
  color: #1a1d1e;
  line-height: 1.5;
  word-break: break-all;
}

.state-good {
  color: #15803d;
}

.state-warn {
  color: #b45309;
}

.state-bad {
  color: #b91c1c;
}

.state-neutral {
  color: #475569;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.action-btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 26rpx;
}

.result-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
  background: #ebf7ee;
  color: #2fa15c;
}

.result-badge.state-good {
  background: #ecfdf5;
  color: #15803d;
}

.result-badge.state-warn {
  background: #fff7ed;
  color: #b45309;
}

.result-badge.state-bad {
  background: #fef2f2;
  color: #b91c1c;
}

.result-text {
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.7;
  font-size: 26rpx;
  color: #1a1d1e;
  background: #f8faf8;
  border-radius: 18rpx;
  padding: 20rpx;
}

.selectable {
  user-select: text;
}

