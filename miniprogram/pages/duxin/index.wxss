.page {
  min-height: 100vh;
  padding: 18rpx 0 56rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef8f0 0%, #f8fbf7 46%, #edf6ee 100%);
}

.duxin-header {
  position: relative;
  overflow: hidden;
  margin: 18rpx 20rpx 18rpx;
  padding: 42rpx 34rpx 34rpx;
  border-radius: 40rpx;
  color: #fff;
  background: linear-gradient(135deg, #1f2422 0%, #303735 58%, #191d1d 100%);
  box-shadow: 0 18rpx 44rpx rgba(24, 27, 28, 0.14);
}

.duxin-header::after {
  content: '';
  position: absolute;
  right: -28rpx;
  top: -18rpx;
  width: 172rpx;
  height: 172rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, rgba(197, 245, 92, 0.96), rgba(37, 206, 111, 0.46));
  transform: rotate(8deg);
}

.header-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 28rpx;
}

.title-area {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.main-title {
  margin-bottom: 12rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
}

.sub-title {
  max-width: 430rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.76);
  line-height: 1.62;
}

.header-actions {
  width: 180rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 22rpx;
}

.icon-btn-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(239, 251, 238, 0.94);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.14);
}

.refresh-icon {
  width: 34rpx;
  height: 34rpx;
}

.archive-btn {
  width: 170rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #b9f271;
  color: #202421;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.category-tabs {
  white-space: nowrap;
  padding: 8rpx 20rpx 12rpx;
  margin-bottom: 10rpx;
  box-sizing: border-box;
}

.tab-item {
  display: inline-block;
  margin-right: 16rpx;
  padding: 14rpx 32rpx;
  border: 2rpx solid rgba(59, 179, 107, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #5f6f64;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(25, 82, 48, 0.05);
}

.tab-item.active {
  color: #1f241f;
  border-color: #c7f35b;
  background: #c7f35b;
}

.input-card {
  margin: 0 20rpx 28rpx;
  padding: 32rpx;
  border: 2rpx solid rgba(59, 179, 107, 0.08);
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 16rpx 34rpx rgba(25, 82, 48, 0.07);
}

.card-light {
  background: rgba(255, 255, 255, 0.94);
}

.main-textarea {
  width: 100%;
  height: 260rpx;
  padding: 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
}

.placeholder-style {
  color: #bdbdbd;
}

.input-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 26rpx;
  gap: 20rpx;
}

.generate-chip {
  min-width: 0;
  flex: 1;
  height: 68rpx;
  line-height: normal;
  margin: 0 auto 0 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #e9f8ed;
  color: #2fa15c;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.generate-chip::after {
  border: 0;
}

.send-btn {
  width: 300rpx;
  flex: 1;
  height: 68rpx;
  line-height: normal;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #24c65f;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 12rpx 24rpx rgba(34, 197, 94, 0.18);
}

.send-btn::after {
  border: 0;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin: 0 20rpx 30rpx;
}

.stat-card {
  position: relative;
  flex: 1;
  overflow: hidden;
  min-height: 128rpx;
  padding: 26rpx 22rpx 24rpx;
  border: 2rpx solid rgba(59, 179, 107, 0.08);
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10rpx 22rpx rgba(25, 82, 48, 0.05);
}

.stat-dark {
  background: #252b2a;
  border-color: rgba(199, 243, 91, 0.22);
  box-shadow: 0 16rpx 34rpx rgba(24, 29, 29, 0.16);
}

.stat-light {
  background: rgba(255, 255, 255, 0.96);
}

.stat-accent {
  grid-column: 1 / -1;
  min-height: 246rpx;
  padding: 34rpx 34rpx 30rpx;
  border-radius: 40rpx;
  background:
    linear-gradient(155deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(145deg, #9fed57 0%, #72d63e 100%);
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 22rpx 46rpx rgba(87, 150, 50, 0.24);
  justify-content: flex-start;
}

.stat-card::after {
  content: '';
  position: absolute;
  top: -26rpx;
  right: -24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(59, 179, 107, 0.12);
}

.risk-card::after {
  background: rgba(199, 243, 91, 0.22);
}

.stat-accent::after {
  top: auto;
  right: -10rpx;
  bottom: -24rpx;
  width: 148rpx;
  height: 168rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  transform: rotate(-10deg);
}

.stat-accent::before {
  content: '';
  position: absolute;
  left: auto;
  right: 46rpx;
  top: 34rpx;
  width: 86rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.26);
  transform: rotate(-14deg);
  z-index: 1;
}

.stat-label {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #8a918e;
  font-weight: 700;
}

.stat-dark .stat-label {
  color: rgba(255, 255, 255, 0.72);
}

.stat-value {
  font-size: 34rpx;
  font-weight: 800;
}

.stat-dark .stat-value {
  color: #c7f35b;
}

.value-green {
  color: #24c65f;
}

.value-purple {
  color: #3bb36b;
}

.stat-accent .value-purple {
  order: -1;
  margin-bottom: 14rpx;
  color: #152015;
  font-size: 54rpx;
  line-height: 1.1;
  position: relative;
  z-index: 2;
}

.stat-accent .stat-label {
  max-width: 360rpx;
  color: rgba(21, 32, 21, 0.74);
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
  position: relative;
  z-index: 2;
}

.stat-action-dot {
  position: absolute;
  left: 34rpx;
  bottom: 30rpx;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  color: #1e2124;
  font-size: 42rpx;
  line-height: 58rpx;
  font-weight: 800;
  text-align: center;
  z-index: 3;
  box-shadow: 0 10rpx 22rpx rgba(43, 91, 38, 0.14);
}

.stat-doc-mark {
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  width: 118rpx;
  height: 138rpx;
  padding: 32rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(230, 255, 214, 0.36);
  box-sizing: border-box;
  transform: rotate(-9deg);
  z-index: 2;
}

.stat-doc-mark view {
  height: 8rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: rgba(21, 32, 21, 0.26);
}

.stat-doc-mark view:nth-child(2) {
  width: 78%;
}

.stat-doc-mark view:nth-child(3) {
  width: 58%;
}

.list-card {
  margin: 0 20rpx 24rpx;
  padding: 34rpx;
  border: 2rpx solid rgba(59, 179, 107, 0.08);
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 14rpx 32rpx rgba(25, 82, 48, 0.06);
}

.list-card-dark {
  background: #252b2a;
  border-color: rgba(199, 243, 91, 0.2);
  box-shadow: 0 18rpx 36rpx rgba(24, 29, 29, 0.16);
}

.list-card-light {
  background: rgba(255, 255, 255, 0.96);
}

.list-card-accent {
  background: #eaffdd;
  border-color: rgba(199, 243, 91, 0.72);
}

.dialog-record-card {
  position: relative;
  overflow: hidden;
  min-height: 220rpx;
}

.dialog-record-card::after {
  content: '';
  position: absolute;
  right: 38rpx;
  bottom: 34rpx;
  width: 112rpx;
  height: 76rpx;
  border-radius: 28rpx;
  background: rgba(199, 243, 91, 0.2);
  border: 4rpx solid rgba(199, 243, 91, 0.46);
  box-shadow: -70rpx -42rpx 0 -18rpx rgba(199, 243, 91, 0.18);
}

.dialog-record-card::before {
  content: '';
  position: absolute;
  right: 118rpx;
  bottom: 98rpx;
  width: 86rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(36, 198, 95, 0.32);
  transform: rotate(-28deg);
}

.memory-summary-card {
  position: relative;
  overflow: hidden;
  min-height: 176rpx;
  background: linear-gradient(135deg, #88dc5a 0%, #bdf067 100%);
  border-color: rgba(139, 221, 91, 0.72);
  box-shadow: 0 18rpx 36rpx rgba(84, 172, 79, 0.18);
}

.memory-summary-card::after {
  content: '';
  position: absolute;
  right: 34rpx;
  bottom: -10rpx;
  width: 112rpx;
  height: 134rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.26);
  transform: rotate(-12deg);
}

.memory-summary-card::before {
  content: '';
  position: absolute;
  right: 62rpx;
  bottom: 52rpx;
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(31, 36, 33, 0.16);
  box-shadow: 0 22rpx 0 rgba(31, 36, 33, 0.12), 0 44rpx 0 rgba(31, 36, 33, 0.1);
  transform: rotate(-12deg);
  z-index: 1;
}

.card-title-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.vertical-bar {
  width: 8rpx;
  height: 30rpx;
  margin-right: 16rpx;
  border-radius: 4rpx;
}

.bar-purple {
  background: #c7f35b;
}

.bar-green {
  background: #24c65f;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2421;
}

.list-card-dark .card-title {
  color: #ffffff;
}

.list-card-accent .card-title {
  color: #1f2421;
}

.card-content {
  position: relative;
  z-index: 2;
  padding-left: 24rpx;
}

.memory-summary-card .bar-purple {
  background: #1f2421;
}

.memory-summary-card .card-title {
  color: #1f2421;
}

.memory-summary-card .body-text {
  max-width: 430rpx;
  color: rgba(31, 36, 33, 0.64);
  font-weight: 700;
}

.empty-text,
.body-text,
.empty-dialog {
  font-size: 26rpx;
  color: #8a918e;
  line-height: 1.7;
}

.list-card-dark .empty-text,
.list-card-dark .body-text,
.list-card-dark .empty-dialog {
  color: rgba(255, 255, 255, 0.68);
}

.empty-dialog {
  padding: 42rpx 0;
  text-align: center;
  color: #a8b4c6;
}

.list-card-dark .empty-dialog {
  color: rgba(199, 243, 91, 0.72);
}

.session-list {
  display: flex;
  gap: 14rpx;
}

.session-item {
  min-width: 220rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f4faf5;
  border: 2rpx solid rgba(59, 179, 107, 0.08);
}

.list-card-dark .session-item {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.82);
}

.session-item.active {
  color: #1f241f;
  background: #c7f35b;
  border-color: #c7f35b;
}

.session-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.session-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.message {
  display: flex;
}

.message.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 90%;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #f4faf5;
  color: #213547;
  line-height: 1.7;
  white-space: pre-wrap;
}

.list-card-dark .bubble {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.86);
}

.message.user .bubble {
  color: #1f241f;
  background: #c7f35b;
}
