.page-shell {
  min-height: 100vh;
  padding: 24rpx;
  background: #f4f7f5;
  box-sizing: border-box;
}

.dashboard-card,
.list-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.dashboard-card {
  padding: 30rpx;
  margin-bottom: 26rpx;
  background:
    linear-gradient(180deg, rgba(190, 232, 63, 0.08), rgba(255, 255, 255, 0.96) 42%),
    #ffffff;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.header-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.logo-tile {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  margin-right: 20rpx;
  background: #bee83f;
  box-shadow: 0 14rpx 28rpx rgba(126, 176, 24, 0.18);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.forum-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(30, 33, 36, 0.22);
}

.title-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cn-title {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #1a1d1e;
}

.header-right {
  display: flex;
  gap: 18rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-refresh {
  background: #fff;
  border: 2rpx solid #e5eaf1;
}

.btn-add {
  background: #3bb36b;
  box-shadow: 0 12rpx 26rpx rgba(59, 179, 107, 0.28);
}

.icon-small {
  width: 32rpx;
  height: 32rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  min-height: 124rpx;
  padding: 28rpx 34rpx;
  border-radius: 18rpx;
  background: #f4f6f2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.stat-item:first-child {
  background: #ebf7ee;
}

.stat-num {
  font-size: 44rpx;
  line-height: 1;
  font-weight: 800;
  color: #1a1d1e;
}

.stat-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #778292;
}

.list-card {
  padding: 28rpx 0 26rpx;
}

.empty-state-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx 64rpx;
  text-align: center;
}

.empty-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: #bee83f;
  display: flex;
  justify-content: center;
  align-items: center;
}

.empty-chat-icon {
  width: 54rpx;
  height: 54rpx;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1a1d1e;
}

.empty-desc {
  margin-bottom: 40rpx;
  font-size: 24rpx;
  color: #787f84;
  line-height: 1.5;
}

.primary-btn {
  width: 360rpx;
  height: 82rpx;
  line-height: normal;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #1e2124;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(30, 33, 36, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn::after {
  border: 0;
}

.muted {
  color: #787f84;
}

.group-card {
  margin: 0 0 20rpx;
}

.group-card:last-child {
  margin-bottom: 0;
}

.group-header {
  padding: 14rpx 28rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.group-heading {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.group-accent {
  width: 8rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #3bb36b 0%, #ebf7ee 100%);
  margin-top: 6rpx;
}

.group-title {
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #1a1d1e;
}

.group-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #787f84;
}

.group-count {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ebf7ee;
  color: #2fa15c;
  font-size: 22rpx;
  border: 1rpx solid #d8efdf;
}

.forum-item {
  position: relative;
  overflow: hidden;
  min-height: 246rpx;
  margin: 0 24rpx 30rpx;
  padding: 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #bdf238 0%, #9fe42e 100%);
  border: 0;
  box-shadow: 0 18rpx 40rpx rgba(91, 139, 28, 0.22);
  box-sizing: border-box;
}

.forum-item::before {
  content: '';
  position: absolute;
  left: -30rpx;
  bottom: 32rpx;
  width: 96rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  transform: rotate(-16deg);
  z-index: 0;
}

.forum-item::after {
  content: '';
  position: absolute;
  right: -22rpx;
  top: 46rpx;
  width: 92rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transform: rotate(-18deg);
  z-index: 0;
}

.forum-item:last-child {
  margin-bottom: 0;
}

.forum-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 22rpx;
  align-items: flex-start;
  padding: 34rpx 30rpx 18rpx 34rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #1e2124;
  border-left: 0;
  border-bottom: 0;
  box-sizing: border-box;
}

.forum-topic {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.35;
  padding-top: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.status {
  min-width: 108rpx;
  padding: 11rpx 18rpx;
  font-size: 22rpx;
  line-height: 1;
  border-radius: 999rpx;
  flex-shrink: 0;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}

.status-running {
  background: #b9ef3f;
  color: #1e2124;
  box-shadow: 0 8rpx 18rpx rgba(185, 239, 63, 0.32);
}

.status-pending {
  background: rgba(255, 255, 255, 0.9);
  color: #1e2124;
}

.status-closed,
.status-finished {
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.78);
}

.forum-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  color: #263126;
  font-size: 22rpx;
  line-height: 1.45;
}

.forum-meta text {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #263126;
  font-weight: 800;
  box-sizing: border-box;
}

.forum-bottom {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 0;
  padding: 14rpx 30rpx 28rpx 34rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: #1e2124;
  box-sizing: border-box;
}

.forum-actions {
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
}

.delete-btn {
  min-width: 104rpx;
  height: 50rpx;
  line-height: 50rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #352626;
  color: #ff8fa2;
  border: 1rpx solid rgba(255, 143, 162, 0.26);
  font-size: 22rpx;
  font-weight: 800;
}

.delete-btn::after {
  border: 0;
}

.delete-modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(18, 20, 21, 0.68);
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-modal {
  width: 100%;
  padding: 38rpx 34rpx 32rpx;
  border-radius: 36rpx;
  background: #1e2021;
  box-shadow: 0 28rpx 70rpx rgba(0, 0, 0, 0.36);
  box-sizing: border-box;
}

.delete-modal-kicker {
  display: inline-flex;
  margin-bottom: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(244, 67, 54, 0.14);
  color: #ff8fa2;
  font-size: 22rpx;
  font-weight: 800;
}

.delete-modal-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.delete-modal-desc {
  margin-top: 16rpx;
  color: #a0a7ad;
  font-size: 25rpx;
  line-height: 1.65;
}

.delete-modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.modal-btn::after {
  border: 0;
}

.modal-btn-cancel {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
}

.modal-btn-danger {
  background: #352626;
  color: #ff8fa2;
  border: 1rpx solid rgba(255, 143, 162, 0.28);
}

.group-empty {
  margin: 0 28rpx 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #cbd5e1;
  background: #f8faf8;
}

.group-empty-text {
  font-size: 24rpx;
  color: #787f84;
}

