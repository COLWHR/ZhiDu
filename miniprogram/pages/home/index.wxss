.page {
  min-height: 100vh;
  background: #f4f7f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 236rpx;
  padding: 40rpx 44rpx;
  margin-bottom: 24rpx;
  border-radius: 48rpx;
  box-sizing: border-box;
  background: #1e2124;
  color: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 28rpx;
}

.hero-brand {
  display: flex;
  align-items: center;
  width: 252rpx;
  height: 92rpx;
  padding: 12rpx 20rpx 12rpx 14rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.13);
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  box-sizing: border-box;
}

.hero-brand-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  margin-right: 16rpx;
  overflow: hidden;
}

.hero-brand-name {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hero .title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #f8fff9;
  margin-bottom: 18rpx;
}

.hero .subtitle {
  font-size: 28rpx;
  line-height: 1.55;
  font-weight: 700;
  color: #d7e4dc;
  opacity: 1;
}

.hero-avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  background: #ebf7ee;
  color: #3bb36b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
  flex: 0 0 auto;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.stat-card:first-child {
  background: #ebf7ee;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1d1e;
  line-height: 1.1;
  margin-bottom: 12rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #787f84;
  line-height: 1.4;
}

.recent-forum-section {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 40rpx 40rpx 72rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1d1e;
  margin-bottom: 72rpx;
  display: block;
}

.empty-state-card {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.icon-circle {
  width: 120rpx;
  height: 120rpx;
  background-color: #ebf7ee;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 42rpx;
}

.empty-icon {
  width: 60rpx;
  height: 60rpx;
  opacity: 0.62;
}

.empty-text-group {
  text-align: center;
  margin-bottom: 44rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1d1e;
  display: block;
  margin-bottom: 16rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: #787f84;
  display: block;
  line-height: 1.6;
  max-width: 460rpx;
}

.primary-create-btn {
  margin: 0;
  background-color: #1e2124;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  width: 320rpx;
  height: 88rpx;
  line-height: normal;
  border-radius: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 12rpx 28rpx rgba(30, 33, 36, 0.18);
}

.primary-create-btn::after {
  border: none;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.forum-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.forum-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid rgba(59, 179, 107, 0.08);
  border-radius: 32rpx;
  background: #f9fbfa;
  box-shadow: 0 8rpx 20rpx rgba(25, 82, 48, 0.04);
  box-sizing: border-box;
}

.forum-item:last-child {
  border-bottom: none;
}

.forum-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #e4f8e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.forum-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.forum-main {
  flex: 1;
  min-width: 0;
}

.forum-topic {
  font-size: 27rpx;
  font-weight: 800;
  color: #1a1d1e;
  line-height: 1.25;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.forum-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a918e;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.forum-status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff0dc;
  color: #df7a22;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
  flex: 0 0 auto;
}

.forum-arrow {
  color: #c8ced8;
  font-size: 30rpx;
  flex: 0 0 auto;
}

.logout-wrapper {
  margin-top: 60rpx;
  text-align: center;
  padding-bottom: 40rpx;
}

.logout-text {
  font-size: 26rpx;
  color: #787f84;
}
