.legal-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f4f7f5 0%, #eef6ee 100%);
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.legal-card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 18rpx 50rpx rgba(25, 42, 28, 0.08);
}

.hero {
  margin-bottom: 32rpx;
}

.legal-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1d1e;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.legal-subtitle {
  display: block;
  font-size: 26rpx;
  color: #6f7672;
  line-height: 1.6;
}

.section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf1ed;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #213126;
  margin-bottom: 16rpx;
}

.section-body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-item {
  display: flex;
  align-items: flex-start;
}

.bullet {
  flex: 0 0 auto;
  width: 28rpx;
  color: #3bb36b;
  font-size: 28rpx;
  line-height: 1.5;
}

.point-text {
  flex: 1;
  font-size: 26rpx;
  color: #46514b;
  line-height: 1.75;
}

.back-btn {
  margin-top: 36rpx;
  width: 100%;
  background: #3bb36b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 42rpx;
  padding: 22rpx 0;
  line-height: 1.35;
}

.back-btn::after {
  border: none;
}
