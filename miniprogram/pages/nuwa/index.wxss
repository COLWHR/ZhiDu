.container {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
  background: #f4f7f5;
}

.header-banner {
  padding: 34rpx 28rpx 26rpx;
  margin-bottom: 24rpx;
  border-radius: 48rpx;
  color: #fff;
  background: #1e2124;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.08);
}

.tag-badge {
  display: inline-block;
  margin-bottom: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.main-title {
  margin-bottom: 14rpx;
  color: #fff;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
}

.sub-title {
  margin-bottom: 26rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 1.55;
}

.stats-row {
  display: flex;
  gap: 20rpx;
}

.stat-box {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  flex-direction: column;
}

.stat-num {
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
}

.section-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.section-title {
  margin-bottom: 22rpx;
  color: #1a1d1e;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
}

.prompt-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #c7f23a 0%, #a8e934 100%);
  box-shadow: 0 18rpx 42rpx rgba(82, 128, 28, 0.22);
}

.prompt-card::before {
  content: '';
  position: absolute;
  top: 24rpx;
  right: 26rpx;
  width: 74rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(22, 163, 74, 0.35);
  transform: rotate(-18deg);
}

.prompt-card .section-title,
.prompt-card .input-area,
.prompt-card .tags-group,
.prompt-card .btn-row {
  position: relative;
  z-index: 1;
}

.prompt-card .section-title {
  color: #111611;
}

.prompt-card .input-area {
  background: rgba(30, 33, 36, 0.12);
}

.prompt-card .agent-textarea {
  color: #172014;
}

.prompt-card .ph-style {
  color: rgba(23, 32, 20, 0.48);
}

.prompt-card .tag-item {
  background: rgba(255, 255, 255, 0.42);
  color: #1f6938;
}

.prompt-card .btn-main {
  background: #1e2124;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(30, 33, 36, 0.2);
}

.prompt-card .btn-sub {
  background: rgba(255, 255, 255, 0.52);
  color: #263424;
}

.input-area {
  margin-bottom: 22rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f8f9fa;
}

.agent-textarea {
  width: 100%;
  height: 150rpx;
  padding: 0;
  color: #333;
  font-size: 24rpx;
  line-height: 1.55;
}

.ph-style {
  color: #b0b0b0;
}

.tags-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag-item {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #ebf7ee;
  color: #2fa15c;
  font-size: 20rpx;
  font-weight: 600;
}

.btn-main {
  flex: 1;
  height: 68rpx;
  line-height: normal;
  margin: 0;
  padding: 0;
  border-radius: 28rpx;
  background: #3bb36b;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(59, 179, 107, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-main::after {
  border: 0;
}

.btn-row {
  display: flex;
  gap: 16rpx;
}

.btn-sub {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #f3f4f6;
  color: #555;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #3bb36b;
}

.process-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx 28rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.process-card::before {
  content: '';
  position: absolute;
  top: 24rpx;
  right: 26rpx;
  width: 74rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.1);
  transform: rotate(-18deg);
}

.process-card::after {
  content: '';
  position: absolute;
  left: 18rpx;
  bottom: 126rpx;
  width: 66rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(59, 179, 107, 0.12);
  transform: rotate(-16deg);
}

.process-card .section-title {
  margin-bottom: 22rpx;
  color: #1a1d1e;
  font-size: 30rpx;
  line-height: 1.2;
  position: relative;
  z-index: 1;
}

.process-card .loading-dot {
  width: 14rpx;
  height: 14rpx;
  background: #3bb36b;
  box-shadow: 0 0 0 8rpx rgba(59, 179, 107, 0.12);
}

.log-box {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
}

.process-card .log-box {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f8f9fa;
  border: 2rpx solid rgba(59, 179, 107, 0.08);
  box-shadow: none;
  position: relative;
  z-index: 1;
}

.log-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.avatar-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #ebf7ee;
  display: flex;
  align-items: center;
  justify-content: center;
}

.process-card .avatar-icon {
  background: #ebf7ee;
  box-shadow: none;
}

.icon-txt {
  font-size: 28rpx;
}

.avatar-name {
  color: #666;
  font-size: 22rpx;
}

.process-card .avatar-name {
  color: #3bb36b;
  font-size: 24rpx;
  font-weight: 800;
}

.log-content {
  color: #333;
  font-size: 22rpx;
  line-height: 1.6;
}

.process-card .log-content {
  color: #333;
  font-size: 25rpx;
  line-height: 1.65;
}

.log-line {
  margin-bottom: 12rpx;
  white-space: pre-wrap;
}

.log-line:last-child {
  margin-bottom: 0;
}

.status-inline {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
  color: #787f84;
  font-size: 24rpx;
  line-height: 1.6;
}

.process-card .status-inline {
  background: #f8f9fa;
  color: #787f84;
  border: 2rpx solid rgba(59, 179, 107, 0.08);
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.log-footer-hint {
  margin-top: 10rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #e5e5e5;
  color: #999;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.process-card .log-footer-hint {
  border-top-color: #e5e5e5;
  color: #2fa15c;
  font-size: 22rpx;
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.persona-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.persona-item {
  padding: 22rpx;
  border-radius: 18rpx;
  background: #f8f9fa;
}

.persona-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.persona-name {
  color: #1a1d1e;
  font-size: 30rpx;
  font-weight: 800;
}

.persona-title {
  margin-top: 6rpx;
  color: #787f84;
  font-size: 24rpx;
}

.saved-tag {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(34, 197, 94, 0.12);
  color: #16a34a;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.persona-bio {
  margin-top: 14rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.7;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.saved-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #475569;
  font-size: 22rpx;
}

.bottom-btn {
  margin-top: 22rpx;
}

