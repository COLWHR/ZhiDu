.page {
  min-height: 100vh;
  padding: 20rpx 0 48rpx;
  box-sizing: border-box;
  background: #f4f7f5;
}

.workshop-header {
  margin: 20rpx;
  padding: 36rpx 30rpx 32rpx;
  border-radius: 48rpx;
  background: #1e2124;
  display: flex;
  flex-direction: column;
}

.header-titles {
  width: 100%;
  margin-bottom: 28rpx;
}

.main-title {
  display: block;
  margin-bottom: 8rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
}

.sub-title {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.header-feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
}

.header-feature-card {
  min-height: 144rpx;
  padding: 22rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(235, 247, 238, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.header-feature-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  text-align: center;
  background: rgba(59, 179, 107, 0.18);
  color: #8de2ad;
  font-size: 32rpx;
  font-weight: 800;
}

.header-feature-title {
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
}

.header-feature-desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 20rpx;
  line-height: 1.2;
}

.action-grid {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0 20rpx 24rpx;
}

.action-card {
  flex: 1;
  position: relative;
  overflow: hidden;
  min-height: 184rpx;
  padding: 32rpx 24rpx 26rpx;
  border: 2rpx solid transparent;
  border-radius: 36rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.action-card::after {
  content: '';
  position: absolute;
  right: -14rpx;
  bottom: -18rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.28);
  transform: rotate(-12deg);
}

.action-card-mint {
  background: linear-gradient(135deg, #b8ea3d 0%, #83d653 100%);
}

.action-card-dark {
  background: #1e2124;
}

.action-card-dark::after {
  content: '';
  position: absolute;
  right: -64rpx;
  bottom: -18rpx;
  width: 132rpx;
  height: 96rpx;
  background: transparent;
  border: 7rpx solid rgba(224, 88, 88, 0.72);
  border-radius: 26rpx;
  box-sizing: border-box;
  transform: rotate(-16deg);
}

.action-card-dark::before {
  content: '';
  position: absolute;
  right: -22rpx;
  bottom: 18rpx;
  width: 122rpx;
  height: 86rpx;
  border-radius: 26rpx;
  border: 7rpx solid rgba(224, 88, 88, 0.58);
  transform: rotate(-16deg);
}

.action-card-dark .action-name::after {
  content: '';
  position: absolute;
  right: -174rpx;
  bottom: -44rpx;
  width: 138rpx;
  height: 94rpx;
  border: 6rpx solid rgba(224, 88, 88, 0.42);
  border-radius: 24rpx;
  background: transparent;
  transform: rotate(-16deg);
}

.icon-wrap {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.blue-bg {
  color: #1e2124;
  background: rgba(255, 255, 255, 0.82);
  font-size: 30rpx;
  font-weight: 800;
  position: relative;
  z-index: 1;
}

.action-card-dark .blue-bg {
  color: #1e2124;
  background: #ffffff;
}

.action-name {
  font-size: 31rpx;
  color: #1a1d1e;
  font-weight: 800;
  position: relative;
  z-index: 1;
}

.action-card-dark .action-name {
  color: #ffffff;
  z-index: 2;
}

.search-row {
  display: flex;
  gap: 18rpx;
  margin: 0 20rpx 30rpx;
}

.search-box {
  flex: 1;
  min-height: 76rpx;
  padding: 0 28rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  background: #fff;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.03);
}

.search-box input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 26rpx;
}

.placeholder-style {
  color: #a8afa9;
}

.filter-btn {
  min-width: 142rpx;
  min-height: 54rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(185, 239, 63, 0.16);
  border-radius: 999rpx;
  background: #34383a;
  color: #b9ef3f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(30, 33, 36, 0.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.agent-list {
  padding: 0 20rpx 40rpx;
}

.agent-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.card-border-left {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}

.border-purple {
  background: linear-gradient(180deg, #3bb36b 0%, #ebf7ee 100%);
}

.border-green {
  background: linear-gradient(180deg, #1e2124 0%, #ebf7ee 100%);
}

.agent-row-main {
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
}

.agent-initial {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #dff0cf;
  color: #53624f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  flex: 0 0 auto;
}

.agent-content {
  flex: 1;
  min-width: 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
  gap: 14rpx;
}

.agent-header-left {
  display: flex;
  flex-direction: column;
}

.agent-name {
  margin-bottom: 6rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1d1e;
  line-height: 1.25;
}

.agent-role {
  font-size: 22rpx;
  color: #3bb36b;
  line-height: 1.3;
}

.tag-status {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #ebf7ee;
  color: #2fa15c;
  font-size: 20rpx;
  flex: 0 0 auto;
}

.agent-desc {
  margin-bottom: 14rpx;
  font-size: 23rpx;
  color: #787f84;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.s-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1;
}

.tag-purple {
  background: #ebf7ee;
  color: #2fa15c;
}

.card-footer {
  margin-left: 114rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #eef2ef;
  display: flex;
  justify-content: space-between;
}

.agent-action-btn {
  color: #2fa15c;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  font-weight: 700;
}

.action-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.text-red {
  color: #ef4444;
}

.empty-state-card {
  padding: 64rpx 36rpx;
  border-radius: 48rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: #e4f8e9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-img {
  width: 54rpx;
  height: 54rpx;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1a1d1e;
}

.empty-subtitle {
  margin-bottom: 40rpx;
  font-size: 24rpx;
  color: #787f84;
  line-height: 1.5;
}

.primary-empty-btn {
  width: 340rpx;
  height: 82rpx;
  line-height: normal;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #1e2124;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(30, 33, 36, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-empty-btn::after {
  border: 0;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(30, 33, 36, 0.52);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 56rpx 20rpx 40rpx;
  box-sizing: border-box;
  overflow-y: auto;
  z-index: 50;
}

.panel {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 24rpx;
  border-radius: 48rpx;
  background: #fff;
}

.form-panel {
  width: 100%;
  max-height: none;
  padding: 36rpx 26rpx 28rpx;
  border-radius: 48rpx;
  box-shadow: 0 22rpx 60rpx rgba(15, 23, 42, 0.26);
  box-sizing: border-box;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1d1e;
  margin-bottom: 20rpx;
}

.form-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a1d1e;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 22rpx;
}

.field text {
  display: block;
  margin-bottom: 10rpx;
  color: #787f84;
  font-size: 26rpx;
  font-weight: 600;
}

.field input,
.field textarea {
  width: 100%;
  border-radius: 28rpx;
  background: #f8faf8;
  box-sizing: border-box;
  color: #1f2937;
  font-size: 28rpx;
}

.field input {
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
}

.form-textarea {
  padding: 22rpx 20rpx;
  line-height: 1.55;
}

.bio-textarea {
  min-height: 260rpx;
  height: 260rpx;
}

.prompt-textarea {
  min-height: 300rpx;
  height: 300rpx;
}

.form-placeholder {
  color: #9ca3af;
  font-size: 28rpx;
}

.detail-item {
  margin-bottom: 16rpx;
}

.label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.mono {
  font-family: monospace;
  white-space: pre-wrap;
}

.panel-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  align-items: center;
}

.action {
  margin: 0;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  line-height: normal;
  padding: 0;
  border-radius: 38rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.action.primary {
  background: #3bb36b;
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(59, 179, 107, 0.24);
}

.action::after {
  border: none;
}
